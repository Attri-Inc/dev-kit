{
  "$schema": "https://docs.claude.com/schemas/settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm test*)",
      "Bash(pnpm test*)",
      "Bash(yarn test*)",
      "Bash(pytest*)",
      "Bash(go test*)",
      "Bash(mvn test*)",
      "Bash(./gradlew test*)",
      "Bash(ruff check*)",
      "Bash(ruff format*)",
      "Bash(biome*)",
      "Bash(tsc*)",
      "Bash(mypy*)",
      "Bash(pre-commit run*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Read(./**)",
      "Edit(./**)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -rf /*)",
      "Bash(sudo*)",
      "Bash(curl*|*sh*)",
      "Bash(wget*|*sh*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout --orphan*)",
      "Bash(git commit*--no-verify*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "Bash(pnpm add*)",
      "Bash(yarn add*)",
      "Bash(go install*)",
      "Bash(brew install*)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(*--dangerously-skip-permissions*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/credentials*.json)",
      "Read(./**/client_secret*.json)",
      "Read(./**/token.pickle)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/credentials*.json)",
      "Edit(./CLAUDE.md)"
    ]
  },
  "_doc_deny_overrides_bypass": "PreToolUse deny is the only override that beats defaultMode: bypassPermissions. This is per Anthropic's security docs. NEVER set defaultMode to bypassPermissions org-wide.",
  "_doc_read_deny_does_not_stop_bash": "Per Anthropic: Read/Edit deny rules do NOT block Bash. We've added the most common shell-shaped exfil patterns to the Bash deny list above. For full enforcement, run Claude Code in a sandboxed container.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-bash-safety.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/quality-gate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-git-push.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "_doc": "Anthropic does NOT audit MCP servers. Pin every server you trust here. Headless mode disables trust verification — never use headless with unvetted servers."
  }
}
